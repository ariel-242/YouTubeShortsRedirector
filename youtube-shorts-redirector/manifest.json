{
  "manifest_version": 3,
  "name": "YouTube Shorts Redirector",
  "version": "1.1",
  "description": "Redirect Shorts URLs to the regular YouTube player. Click the icon to toggle on/off.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/shorts/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
